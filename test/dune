(tests
 (names test_troopl test_position test_lexer test_parser test_lowerer
        test_evaluator test_examples test_environment test_stdlib test_cli
        test_specification test_calculator)
 (modules (:standard \ process_child))
 (libraries troopl unix)
 (deps (source_tree ../examples) (source_tree ../stdlib) ../bin/main.exe
       process_child.exe))

(executable
 (name process_child)
 (modules process_child))

; Compile the same private implementation with the Windows branch selected.
; This tests its concurrency on this host without expanding the public API.
(rule
 (target system_threaded.ml)
 (deps ../lib/system.ml)
 (action
  (with-stdout-to %{target}
   (progn
    (echo "open Troopl\nmodule Sys = struct include Sys let win32 = true end\n")
    (cat %{dep:../lib/system.ml})))))

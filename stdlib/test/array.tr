# Arrays: mutation methods, copies, appending.
(expect "push" (array push 1 push 2) (list < 1 , 2 >))
(expect "set" (array push 1 push 2 set 0 9) (list < 9 , 2 >))
(
    A (array push 1 push 2 push 3)
    (expect "pop returns the last element" (A pop) 3)
    (expect "pop removes it" A (list < 1 , 2 >))
)
(expect "clear" (array push 1 push 2 clear size) 0)
(
    A (array push 1 push 2)
    (A insert 2 9)
    (A insert 0 7)
    (expect "insert" A (list < 7 , 1 , 2 , 9 >))
)
(
    A (array push 1 push 2 push 3)
    (expect "remove returns the element" (A remove 1) 2)
    (expect "remove shifts left" A (list < 1 , 3 >))
)
(expect "append" (array push 1 append (list < 2 , 3 >)) (list < 1 , 2 , 3 >))
(expect "append minimal list" (array push 1 append {at I (5) size (2)})
    (list < 1 , 5 , 5 >))
(
    A (array push 1 push 2)
    (A append A)
    (expect "append itself terminates" A (list < 1 , 2 , 1 , 2 >))
)
(expect "reverse-in-place" (array push 1 push 2 push 3 reverse-in-place)
    (list < 3 , 2 , 1 >))
(expect "sort-in-place" (array push 3 push 1 push 2 sort-in-place)
    (list < 1 , 2 , 3 >))
(
    A (array push 1)
    B (A copy)
    (B push 2)
    (expect "copy is independent" (A size) 1)
    (expect "copy is an array" B (list < 1 , 2 >))
)
(expect "to-array" (list < 1 , 2 > to-seq to-array push 3) (list < 1 , 2 , 3 >))

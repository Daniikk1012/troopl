# Strings: list methods returning strings, conversions.
(expect "concatenation" ("Hello" + ", " + "Troopl!") "Hello, Troopl!")
(expect "sub" ("abcdef" sub 1 4) "bcd")
(expect "empty sub" ("abcdef" sub 2 2) "")
(expect "reverse" ("я🙂" reverse) "🙂я")
(expect "reverse copy" ("abc" reverse copy) "cba")
(check "equal" ("same" = "same"))
(refute "not equal" ("same" = "other"))
(check "less" ("abc" < "abd"))
(check "prefix is less" ("ab" < "abc"))
(expect "to-string escapes quotes" ("say ""hi""" to-string) """say """"hi""""""")
(expect "sort returns a string" ("cba" sort) "abc")
(expect "sort to-string" ("cba" sort to-string) """abc""")
(expect "to-bytes" ("é" to-bytes) (list < 195 , 169 >))
(expect "find-sub-index" ("abababc" find-sub-index "ababc") 2)
(expect "find-sub-index empty needle" ("abc" find-sub-index "") 0)

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TrOOPL",
  "scopeName": "source.troopl",
  "fileTypes": [
    "tr"
  ],
  "comment": "Generated by editors/generate.py; do not edit.",
  "patterns": [
    {
      "begin": "\\A[ \\t]*([^ \\t\\r\\n()\\[\\]{}\"#0-9\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)",
      "beginCaptures": {
        "1": {
          "name": "support.function.environment.troopl"
        }
      },
      "end": "(?=[)\\]])",
      "patterns": [
        {
          "include": "#chain"
        }
      ]
    },
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.troopl",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.troopl"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.troopl",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.troopl"
        }
      },
      "end": "\"(?!\")",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.troopl"
        }
      },
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.troopl"
        }
      ]
    },
    "environment": {
      "match": "(\\()[ \\t]*(\\))",
      "name": "variable.language.environment.troopl"
    },
    "paren": {
      "name": "meta.group.troopl",
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.troopl"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.troopl"
        }
      },
      "patterns": [
        {
          "begin": "\\G[ \\t]*([^ \\t\\r\\n()\\[\\]{}\"#0-9\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)",
          "beginCaptures": {
            "1": {
              "name": "support.function.environment.troopl"
            }
          },
          "end": "(?=[)\\]])",
          "patterns": [
            {
              "include": "#chain"
            }
          ]
        },
        {
          "include": "#statements"
        }
      ]
    },
    "block": {
      "name": "meta.block.troopl",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.troopl"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.troopl"
        }
      },
      "patterns": [
        {
          "begin": "\\G[ \\t]*([^ \\t\\r\\n()\\[\\]{}\"#0-9\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)",
          "beginCaptures": {
            "1": {
              "name": "support.function.environment.troopl"
            }
          },
          "end": "(?=[)\\]])",
          "patterns": [
            {
              "include": "#chain"
            }
          ]
        },
        {
          "include": "#statements"
        }
      ]
    },
    "object": {
      "name": "meta.object.troopl",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.troopl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.troopl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#method-definition"
        },
        {
          "include": "#values"
        }
      ]
    },
    "method-definition": {
      "name": "meta.method.troopl",
      "begin": "([^ \\t\\r\\n()\\[\\]{}\"#0-9\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.troopl"
        }
      },
      "end": "(?=[^ \\t\\r\\n#\\p{Lu}\\p{Lt}])",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "[\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*",
          "name": "variable.parameter.troopl"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "([\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)[ \\t]+([\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)",
          "captures": {
            "1": {
              "name": "entity.name.variable.troopl"
            },
            "2": {
              "name": "variable.other.troopl"
            }
          }
        },
        {
          "match": "([\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)[ \\t]+((?:0nan|0inf-?|[0-9]+(?:\\.[0-9]*)?-?)(?![^ \\t\\r\\n()\\[\\]{}\"#]))",
          "captures": {
            "1": {
              "name": "entity.name.variable.troopl"
            },
            "2": {
              "name": "constant.numeric.troopl"
            }
          }
        },
        {
          "match": "([\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)(?=[ \\t]*[(\\[{\"])",
          "captures": {
            "1": {
              "name": "entity.name.variable.troopl"
            }
          }
        },
        {
          "begin": "([-+*/\\\\^=<>!&|%~.,:;@$?'`]+(?![^ \\t\\r\\n()\\[\\]{}\"#]))|([^ \\t\\r\\n()\\[\\]{}\"#0-9\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.troopl"
            },
            "2": {
              "name": "entity.name.function.call.troopl"
            }
          },
          "end": "(?=[)\\]])",
          "patterns": [
            {
              "include": "#chain"
            }
          ]
        },
        {
          "include": "#values"
        }
      ]
    },
    "chain": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "[-+*/\\\\^=<>!&|%~.,:;@$?'`]+(?![^ \\t\\r\\n()\\[\\]{}\"#])",
          "name": "keyword.operator.troopl"
        },
        {
          "match": "[^ \\t\\r\\n()\\[\\]{}\"#0-9\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*",
          "name": "entity.name.function.call.troopl"
        },
        {
          "include": "#values"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#environment"
        },
        {
          "include": "#paren"
        },
        {
          "include": "#block"
        },
        {
          "include": "#object"
        },
        {
          "include": "#string"
        },
        {
          "match": "(?:0nan|0inf-?|[0-9]+(?:\\.[0-9]*)?-?)(?![^ \\t\\r\\n()\\[\\]{}\"#])",
          "name": "constant.numeric.troopl"
        },
        {
          "match": "[0-9][^ \\t\\r\\n()\\[\\]{}\"#]*",
          "name": "invalid.illegal.numeric.troopl"
        },
        {
          "match": "[\\p{Lu}\\p{Lt}][^ \\t\\r\\n()\\[\\]{}\"#]*",
          "name": "variable.other.troopl"
        }
      ]
    }
  }
}

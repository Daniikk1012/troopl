# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A powerful minimal OO language with object capability system"
description:
  "TrOOPL is a minimal object-oriented programming language with a purely functional core, where dependency injection, mutability, and capabilities like I/O and file system access are managed through explicitly passed and constructed environment objects."
authors: ["Daniyar Sarbassov" "Nazar Tasmulayev" "Bogdan Ichshenko"]
homepage: "https://github.com/Daniikk1012/troopl"
bug-reports: "https://github.com/Daniikk1012/troopl/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml"
  "uucp"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Daniikk1012/troopl.git"
x-maintenance-intent: ["(latest)"]
